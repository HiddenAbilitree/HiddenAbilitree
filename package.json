{
  "name": "HiddenAbilitree",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check-types": "turbo run check-types",
    "index": "bun run --cwd packages/indexer index"
  },
  "dependencies": {
    "babel-plugin-react-compiler": "^1.0.0"
  },
  "devDependencies": {
    "@hiddenability/opinionated-defaults": "^0.2.0",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.9"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.13",
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
